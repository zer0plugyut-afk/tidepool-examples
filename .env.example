# ENV=TIDEPOOL (testnet, default) or ONECLICK (mainnet 1Click: https://1click.chaindefuser.com)
ENV=TIDEPOOL
# Optional: override the base URL directly
# TIDEPOOL_URL=https://www.usetidepool.tech
# Optional: your NEAR testnet account. If unset, a throwaway account is created and kept in .example-account.json (gitignored).
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
# Optional: NEAR RPC
# NEAR_RPC=https://test.rpc.fastnear.com
# Mainnet 1Click only: JWT for fee-free quotes
ONECLICK_JWT=
# evm-deposit.ts only: a TESTNET-ONLY EVM key with Sepolia gas, chain base|arb|eth, NEAR recipient
EVM_PRIVATE_KEY=
EVM_CHAIN=base
RECIPIENT=
